# 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# 被测服务基础 URL
BASE_URL={{ base_url }}

# 请求超时（秒）
TIMEOUT=30

# 失败重试次数
RETRY_COUNT=0

{% if auth_mode == "token" %}
# — 认证配置 —
{{ auth_env_var }}=your_api_key_here

{% elif auth_mode == "session" %}
# — 登录认证配置 —
LOGIN_USERNAME=admin
LOGIN_PASSWORD=your_password_here

{% endif %}
