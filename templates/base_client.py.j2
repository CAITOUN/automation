# === AUTO_GENERATED_START ===
import time
from uuid import uuid4
from urllib.parse import urljoin

import requests

from utils.logger import get_logger

logger = get_logger("api")

SENSITIVE_KEYS = {"password", "token", "secret", "api_key", "authorization", "x-api-key"}


class BaseClient:
    """HTTP 客户端基类。封装 requests，统一日志、脱敏、重试、超时。"""

    def __init__(self, base_url, session=None, timeout=30, retry=0):
        self.base_url = base_url.rstrip("/")
        self.session = session or requests.Session()
        self.timeout = timeout
        self.retry = retry

    def _redact(self, d):
        """脱敏处理：隐藏敏感字段的值"""
        if not isinstance(d, dict):
            return d
        return {
            k: ("***" if str(k).lower() in SENSITIVE_KEYS else v)
            for k, v in d.items()
        }

    def _request(self, method, path, **kwargs):
        url = urljoin(self.base_url + "/", path.lstrip("/"))
        headers = kwargs.pop("headers", {})
        timeout = kwargs.pop("timeout", self.timeout)
        retry = kwargs.pop("retry", self.retry)

        req_id = uuid4().hex[:8]

        # — 请求日志 —
        logger.info("[%s] --> %s %s", req_id, method.upper(), url)
        logger.debug("[%s] headers: %s", req_id, self._redact(headers))
        if "json" in kwargs:
            logger.debug("[%s] body: %s", req_id, kwargs["json"])

        start = time.time()
        last_exc = None

        for attempt in range(retry + 1):
            try:
                resp = self.session.request(method, url, headers=headers, timeout=timeout, **kwargs)
                break
            except requests.RequestException as e:
                last_exc = e
                if attempt < retry:
                    logger.warning("[%s] retry %d/%d: %s", req_id, attempt + 1, retry, e)

        else:
            raise last_exc

        elapsed = (time.time() - start) * 1000
        status_icon = "✓" if resp.ok else "✗"

        # — 响应日志 —
        logger.info(
            "[%s] <-- %s %s %.0fms",
            req_id, status_icon, resp.status_code, elapsed,
        )
        logger.debug("[%s] response: %s", req_id, resp.text[:1000])

        if not resp.ok:
            logger.warning(
                "[%s] FAILED: %s | %s",
                req_id, resp.status_code, resp.text[:500],
            )

        return resp

    def get(self, path, **kwargs):
        return self._request("GET", path, **kwargs)

    def post(self, path, **kwargs):
        return self._request("POST", path, **kwargs)

    def put(self, path, **kwargs):
        return self._request("PUT", path, **kwargs)

    def delete(self, path, **kwargs):
        return self._request("DELETE", path, **kwargs)

    def patch(self, path, **kwargs):
        return self._request("PATCH", path, **kwargs)

# === AUTO_GENERATED_END ===
