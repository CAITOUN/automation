# utils/logger.py — 日志配置
# === AUTO_GENERATED_START ===
import logging
import sys

_loggers = {}


def get_logger(name: str) -> logging.Logger:
    """获取命名 logger，单例模式避免重复添加 handler"""
    if name in _loggers:
        return _loggers[name]

    logger = logging.getLogger(name)
    logger.setLevel(logging.DEBUG)
    logger.propagate = False  # 不向根 logger 传播，避免 pytest 重复捕获

    formatter = logging.Formatter(
        "%(asctime)s | %(name)-8s | %(levelname)-5s | %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )

    # 控制台 handler — 默认 WARNING，减少噪音
    if not logger.handlers:
        console = logging.StreamHandler(sys.stdout)
        console.setLevel(logging.WARNING)
        console.setFormatter(formatter)
        logger.addHandler(console)

        # 文件 handler — 全量 DEBUG，每次覆盖
        file_handler = logging.FileHandler("test_run.log", mode="w", encoding="utf-8")
        file_handler.setLevel(logging.DEBUG)
        file_handler.setFormatter(formatter)
        logger.addHandler(file_handler)

    _loggers[name] = logger
    return logger

# === AUTO_GENERATED_END ===
